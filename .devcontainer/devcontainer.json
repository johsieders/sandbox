// GitHub Codespace / dev container for sandbox.
// Python itself comes from uv (pinned in .python-version), packages from uv.lock.
{
  "name": "sandbox",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  // uv version as on Mac and Pi (docs/multi_platform.md); then build .venv exactly from uv.lock
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/0.12.19/install.sh | sh && ~/.local/bin/uv sync --locked",

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
